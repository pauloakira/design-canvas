{
  "name": "design-canvas",
  "version": "0.1.0",
  "description": "A free, local-first design tool for engineers, with first-class Claude Code / Codex (MCP) and Claude / GPT integration.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "design-canvas": "./bin/design-canvas.mjs",
    "design-canvas-mcp": "./bin/design-canvas-mcp.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "mcp": "node bin/design-canvas-mcp.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/shared/*.test.ts src/server/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/browser": "^4.3.5",
    "dompurify": "^3.4.18",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "immer": "^11.2.10",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20"
  }
}
